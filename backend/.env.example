# Application Settings
PROJECT_NAME="TalentMatch API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# CORS Configuration (comma-separated list or JSON array of allowed origins)
# FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=talentmatch_db

# SQLAlchemy Connection String (constructed automatically if not set)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/talentmatch_db

# Local File Storage Configuration
CV_STORAGE_PATH=storage/cvs
MAX_CV_FILE_SIZE_MB=10

# OpenRouter Configuration (AI Screening Engine)
# Required: Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MAX_CV_TEXT_LENGTH=8000

